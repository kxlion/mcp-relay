# MCP Relay private credential store.
# Place this file beside the selected config.yaml (or pass it to Docker
# Compose as its env-file). MCP Relay reads it directly; it does not expand
# variables, execute shell syntax, or copy values into child-process environments.
# Keep this file private (mode 0600 on POSIX) and never commit real values.

RELAY_MCP_TOKEN=[GENERATE_A_PRIVATE_MCP_TOKEN]
RELAY_CLIENT_TOKEN=[GENERATE_A_PRIVATE_CLIENT_TOKEN]
